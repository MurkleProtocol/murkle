# Caddy in front of a Murkle node: TLS (automatic certificates), HSTS, and the indexer upstream.
#   everything (the site, /api/*, /artifacts/*) -> the indexer (:8787)
# Environment: SITE_DOMAIN (required), ACME_EMAIL (required: certificate notices) and INDEXER_UPSTREAM
# (default for a host install; the compose file sets the service name).
# Set MURKLE_TRUST_PROXY=1 only behind this proxy.
#
# Privacy: no access log (there is no "log" directive in the site block). The server sends its
# own Content-Security-Policy and security headers; MURKLE_CSP_ENFORCE=1 makes the CSP enforcing.
{
	email {$ACME_EMAIL}
	# No trusted_proxies: Caddy is the edge, so the client address is the TCP peer and an
	# incoming X-Forwarded-For is never believed ({remote_host} below).
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy {$INDEXER_UPSTREAM:127.0.0.1:8787} {
			# Overwrite, never append: the relayer rate-limits by this address.
			header_up X-Forwarded-For {remote_host}
			transport http {
				# Below the indexer's own 65 s, so an idle connection is never reused as it closes.
				keepalive 60s
			}
		}
	}
}
