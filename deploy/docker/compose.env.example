# Settings for deploy/docker/docker-compose.yml. Copy to deploy/docker/compose.env and pass it:
#   docker compose -f deploy/docker/docker-compose.yml --env-file deploy/docker/compose.env up -d
# No secrets here: Bitcoin Core (optional) uses cookie authentication on the compose network.

# signet or mainnet.
MURKLE_NETWORK=signet
# Chain data: mempool.space's Esplora API (the default; no Bitcoin Core is started).
MURKLE_BTC_SOURCE=esplora
# Mainnet:
# MURKLE_NETWORK=mainnet
# MURKLE_CSP_ENFORCE=1

# Optional upgrade, an own Bitcoin Core: set MURKLE_BTC_SOURCE=bitcoind above, start the stack with
# --profile bitcoind, and set the matching Bitcoin Core chain (signet or main), RPC port and cookie
# path. These and the release below are read only by the bitcoind and electrs profiles.
BITCOIN_CHAIN=signet
BITCOIN_RPC_PORT=38332
BITCOIN_COOKIE=/bitcoin/signet/.cookie
# Mainnet:
# BITCOIN_CHAIN=main
# BITCOIN_RPC_PORT=8332
# BITCOIN_COOKIE=/bitcoin/.cookie

# Bitcoin Core release and the sha256 of its tarball (from the signed SHA256SUMS). Needed only with the
# bitcoind profile (the build refuses an empty value); the default Esplora setup can leave them out.
# BITCOIN_VERSION=REPLACE_WITH_THE_RELEASE
# BITCOIN_SHA256=REPLACE_WITH_THE_TARBALL_SHA256

# The site.
SITE_DOMAIN=murkle.example.org
ACME_EMAIL=ops@murkle.example.org
MURKLE_PUBLIC_URL=https://murkle.example.org
# Left unset, the server enforces the CSP on mainnet (go/no-go list) and keeps it Report-Only on
# signet. Set 1 or 0 only to override that.
# MURKLE_CSP_ENFORCE=
# Where the image fetches the pinned artifacts at its first start (any Murkle site serves them).
MURKLE_ARTIFACTS_URL=https://murkle.example.org/artifacts

# Optional electrs (profile electrs): pin the image by digest before use.
ELECTRS_IMAGE=mempool/electrs:latest
