# Murkle node on signet: /etc/murkle/murkle.env (root:murkle, mode 0640).
# Read by murkle-indexer.service, murkle-monitor.service and murkle-backup.service.
# No secrets in this file: secrets live in files under /etc/murkle/secrets/ and only their
# paths appear here. Every name is documented in docs/design/mainnet-readiness.md section 8,
# README.md and docs/OPERATIONS.md.

MURKLE_NETWORK=signet

# HTTP: the indexer listens on localhost; the reverse proxy (deploy/caddy, deploy/nginx) serves HTTPS.
MURKLE_INDEXER_PORT=8787
MURKLE_PUBLIC_URL=https://signet.murkle.example.org
# Only behind the proxy, which overwrites X-Forwarded-For with the client address.
MURKLE_TRUST_PROXY=1
# Content-Security-Policy: Report-Only on signet, as today. Mainnet enforces it (go/no-go item).
MURKLE_CSP_ENFORCE=0

# State lives outside the read-only code directory.
MURKLE_STATE_PATH=/var/lib/murkle/signet/state.json
MURKLE_HEADERS_PATH=/var/lib/murkle/signet/headers.json
MURKLE_HEALTH_MAX_LAG=3

# Chain data: mempool.space's Esplora API by default. With your own Bitcoin Core (txindex=1,
# deploy/bitcoin/bitcoin.conf.example) switch to the RPC source:
MURKLE_BTC_SOURCE=esplora
# MURKLE_ESPLORA=https://mempool.space/signet/api
# MURKLE_BTC_SOURCE=bitcoind
# MURKLE_BITCOIND_URL=http://127.0.0.1:38332
# MURKLE_BITCOIND_COOKIE=/var/lib/bitcoind/signet/.cookie

# Retired free-relayer files (read only, for old relay ids); kept inside the data directory.
MURKLE_RELAY_KEY_PATH=/var/lib/murkle/signet/relayer.key
MURKLE_RELAY_STATE_PATH=/var/lib/murkle/signet/relayer.json
# The paid relayer is switched on by the drop-in deploy/systemd/murkle-indexer.service.d/relayer.conf.example,
# never here: values in this file would override the drop-in's Environment= lines.

# Monitor (deploy/bin/monitor.mjs, every minute).
MURKLE_MONITOR_URL=http://127.0.0.1:8787
MURKLE_MONITOR_DATA_DIR=/var/lib/murkle
MURKLE_MONITOR_MAX_LAG=3
MURKLE_MONITOR_MIN_FREE_GB=20
# MURKLE_MONITOR_WEBHOOK=https://alerts.murkle.example.org/hook
# MURKLE_MONITOR_CEREMONY_URL=http://127.0.0.1:8790

# Encrypted backups (deploy/bin/backup.mjs). The recipient is the PUBLIC key printed by
# "backup.mjs keygen" on an offline machine; the private key never comes to this server.
MURKLE_BACKUP_RECIPIENT=murkle-backup-pub:REPLACE_WITH_THE_PUBLIC_KEY_FROM_KEYGEN
MURKLE_BACKUP_DIR=/var/backups/murkle
MURKLE_BACKUP_KEEP=48
