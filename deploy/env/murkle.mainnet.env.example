# Murkle node on Bitcoin mainnet: /etc/murkle/murkle.env (root:murkle, mode 0640).
# Mainnet has not launched: the server refuses to start until the mainnet pins hold the
# ceremony's verification key and a genesis (docs/MAINNET.md). MURKLE_ALLOW_PRE_GENESIS=1 is
# for a staging run only and never for the public site.
# No secrets in this file: secrets live in files under /etc/murkle/secrets/ and only their
# paths appear here.

MURKLE_NETWORK=mainnet

MURKLE_INDEXER_PORT=8787
MURKLE_PUBLIC_URL=https://murkle.example.org
MURKLE_TRUST_PROXY=1
# Enforced on mainnet (go/no-go list in docs/MAINNET.md).
MURKLE_CSP_ENFORCE=1

MURKLE_STATE_PATH=/var/lib/murkle/mainnet/state.json
MURKLE_HEADERS_PATH=/var/lib/murkle/mainnet/headers.json
MURKLE_HEALTH_MAX_LAG=3
# Header verification cannot be turned off on mainnet.
MURKLE_HEADERS=on

# Chain data from the operator's own Bitcoin Core (unpruned, txindex=1), cookie authentication.
MURKLE_BTC_SOURCE=bitcoind
MURKLE_BITCOIND_URL=http://127.0.0.1:8332
MURKLE_BITCOIND_COOKIE=/var/lib/bitcoind/.cookie
# Or a user and a password FILE (rpcauth), never a password value:
# MURKLE_BITCOIND_USER=murkle
# MURKLE_BITCOIND_PASSWORD_FILE=/etc/murkle/secrets/bitcoind-rpc-password
# Optional: an Esplora API for wallet lookups the RPC source does not answer (utxos, merkle proofs).
# MURKLE_ESPLORA=https://mempool.space/api

MURKLE_RELAY_KEY_PATH=/var/lib/murkle/mainnet/relayer.key
MURKLE_RELAY_STATE_PATH=/var/lib/murkle/mainnet/relayer.json
# The paid relayer is switched on by the drop-in deploy/systemd/murkle-indexer.service.d/relayer.conf.example.

MURKLE_MONITOR_URL=http://127.0.0.1:8787
MURKLE_MONITOR_DATA_DIR=/var/lib/murkle
MURKLE_MONITOR_MAX_LAG=3
MURKLE_MONITOR_MIN_FREE_GB=20
# MURKLE_MONITOR_WEBHOOK=https://alerts.murkle.example.org/hook
# MURKLE_MONITOR_CEREMONY_URL=http://127.0.0.1:8790

MURKLE_BACKUP_RECIPIENT=murkle-backup-pub:REPLACE_WITH_THE_PUBLIC_KEY_FROM_KEYGEN
MURKLE_BACKUP_DIR=/var/backups/murkle
MURKLE_BACKUP_KEEP=48
