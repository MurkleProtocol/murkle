# Ceremony coordinator: /etc/murkle/ceremony.env (root:murkle, mode 0640), read by
# murkle-ceremony.service. The procedure is in docs/CEREMONY.md.

MURKLE_NETWORK=mainnet
MURKLE_CEREMONY_HOST=127.0.0.1
MURKLE_CEREMONY_PORT=8790
MURKLE_CEREMONY_DIR=/var/lib/murkle/ceremony/murkle-mainnet-1
MURKLE_CEREMONY_R1CS=/opt/murkle/current/build/transaction.r1cs
MURKLE_CEREMONY_PTAU=/opt/murkle/current/build/ptau/powersOfTau28_hez_final_15.ptau
MURKLE_CEREMONY_SLOT_SECS=900
MURKLE_CEREMONY_HEARTBEAT_SECS=60
MURKLE_CEREMONY_MAX_QUEUE=200
MURKLE_CEREMONY_JOIN_PER_HOUR=6
MURKLE_CEREMONY_MAX_PER_PREFIX=2
MURKLE_CEREMONY_VERIFY_SECS=600
# Only behind the reverse proxy, which overwrites X-Forwarded-For.
MURKLE_CEREMONY_TRUST_PROXY=1

# The coordinator closes itself before the beacon height when it can read the chain tip.
MURKLE_BTC_SOURCE=bitcoind
MURKLE_BITCOIND_URL=http://127.0.0.1:8332
MURKLE_BITCOIND_COOKIE=/var/lib/bitcoind/.cookie
